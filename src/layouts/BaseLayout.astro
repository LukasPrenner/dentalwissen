---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Unabhängige, verständliche Einordnungen rund um Zahngesundheit.' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<html lang="de">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-white text-slate-900 antialiased">
		<header class="border-b border-slate-100">
			<div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
				<a href="/" class="text-lg font-semibold tracking-tight">Dental Wissen</a>
				<nav class="flex gap-5 text-sm text-slate-600">
					<a href="/" class="hover:text-slate-900">Artikel</a>
					<a href="/ueber-uns" class="hover:text-slate-900">Über uns</a>
				</nav>
			</div>
		</header>

		<main class="flex-1">
			<slot />
		</main>

		<footer class="border-t border-slate-100 bg-slate-50">
			<div class="mx-auto max-w-3xl px-4 py-8 text-sm text-slate-500">
				<div class="flex flex-wrap gap-4">
					<a href="/impressum" class="hover:text-slate-700">Impressum</a>
					<a href="/datenschutz" class="hover:text-slate-700">Datenschutz</a>
					<a href="/ueber-uns" class="hover:text-slate-700">Über uns</a>
				</div>
				<p class="mt-4">&copy; {currentYear} Dental Wissen. Alle Inhalte dienen der allgemeinen Information und ersetzen keine zahnärztliche Beratung.</p>
			</div>
		</footer>

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const params = new URLSearchParams(window.location.search);
				if ([...params.keys()].length === 0) return;
				document.querySelectorAll('a[href*="improic.com"]').forEach((link) => {
					const anchor = link as HTMLAnchorElement;
					const url = new URL(anchor.href);
					params.forEach((value, key) => url.searchParams.set(key, value));
					anchor.href = url.toString();
				});
			});
		</script>
	</body>
</html>
