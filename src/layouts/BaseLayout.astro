---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Verständliche Ratgeber rund um Zahnpflege, Zahnfleisch und die passende Zahnpasta.' } = Astro.props;
const currentYear = new Date().getFullYear();
const GTM_ID = 'GTM-M9VGC8CG';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
	{ href: '/zahnpflege-zahnpasta', label: 'Ratgeber' },
	{ href: '/improic-zahnpasta', label: 'Zahnpasta' },
	{ href: '/ueber-uns', label: 'Über uns' },
];
---

<html lang="de">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" />
		<title>{title}</title>

		<script is:inline define:vars={{ GTM_ID }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('consent', 'default', {
				ad_storage: 'denied',
				ad_user_data: 'denied',
				ad_personalization: 'denied',
				analytics_storage: 'denied',
			});
			try {
				var stored = localStorage.getItem('dw_consent');
				if (stored === 'granted') {
					gtag('consent', 'update', {
						ad_storage: 'granted',
						ad_user_data: 'granted',
						ad_personalization: 'granted',
						analytics_storage: 'granted',
					});
				}
			} catch (e) {}

			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != 'dataLayer' ? '&l=' + l : '';
				j.async = true;
				j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, 'script', 'dataLayer', GTM_ID);
		</script>
	</head>
	<body class="flex min-h-screen flex-col bg-paper text-ink antialiased">
		<noscript>
			<iframe
				src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
				height="0"
				width="0"
				style="display:none;visibility:hidden"
			></iframe>
		</noscript>

		<header class="sticky top-0 z-40 border-b border-line/80 bg-white/90 backdrop-blur">
			<div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 sm:h-16 sm:px-6">
				<a href="/" class="flex items-center gap-2 text-ink" aria-label="Dental Wissen – Startseite">
					<span class="grid size-7 place-items-center rounded-full bg-brand-ink text-[13px] font-semibold text-white">dw</span>
					<span class="font-serif text-[1.15rem] font-semibold tracking-tight">Dental Wissen</span>
				</a>
				<nav class="flex items-center gap-4 text-sm sm:gap-7">
					{
						nav.map((item) => (
							<a
								href={item.href}
								class:list={[
									'transition-colors hover:text-ink',
									path === item.href ? 'font-medium text-ink' : 'text-muted',
									item.href === '/ueber-uns' && 'hidden sm:inline',
								]}
							>
								{item.label}
							</a>
						))
					}
				</nav>
			</div>
		</header>

		<main class="flex-1">
			<slot />
		</main>

		<footer class="mt-20 border-t border-line bg-mist">
			<div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-[1.4fr_1fr_1fr] sm:px-6">
				<div>
					<p class="font-serif text-lg font-semibold text-ink">Dental Wissen</p>
					<p class="mt-2 max-w-sm text-sm leading-relaxed text-muted">
						Verständliche Ratgeber rund um Zahnpflege und Zahnfleisch. Alle Inhalte dienen der allgemeinen
						Information und ersetzen keine zahnärztliche Beratung.
					</p>
				</div>
				<div class="text-sm">
					<p class="font-medium text-ink">Inhalte</p>
					<ul class="mt-3 space-y-2 text-muted">
						<li><a href="/zahnpflege-zahnpasta" class="hover:text-ink">Ratgeber Zahnpflege</a></li>
						<li><a href="/improic-zahnpasta" class="hover:text-ink">Zahnpasta</a></li>
						<li><a href="/ueber-uns" class="hover:text-ink">Über uns</a></li>
					</ul>
				</div>
				<div class="text-sm">
					<p class="font-medium text-ink">Rechtliches</p>
					<ul class="mt-3 space-y-2 text-muted">
						<li><a href="/impressum" class="hover:text-ink">Impressum</a></li>
						<li><a href="/datenschutz" class="hover:text-ink">Datenschutz</a></li>
						<li><button type="button" data-open-consent class="hover:text-ink">Cookie-Einstellungen</button></li>
					</ul>
				</div>
			</div>
			<div class="border-t border-line">
				<p class="mx-auto max-w-6xl px-4 py-5 text-xs text-muted sm:px-6">
					&copy; {currentYear} Dental Wissen · Ein Angebot der IMPROIC Dental GmbH
				</p>
			</div>
		</footer>

		<div
			id="cookie-banner"
			class="fixed inset-x-3 bottom-3 z-50 hidden rounded-2xl border border-line bg-white p-4 shadow-[0_12px_40px_-12px_rgba(20,33,43,0.25)] sm:inset-x-auto sm:right-5 sm:bottom-5 sm:max-w-md sm:p-5"
			role="dialog"
			aria-label="Cookie-Einstellungen"
		>
			<p class="text-sm leading-relaxed text-ink-2">
				Wir nutzen Cookies, um die Reichweite unserer Inhalte zu messen und sie zu verbessern. Mehr dazu in
				unserer <a href="/datenschutz" class="underline underline-offset-2 hover:text-ink">Datenschutzerklärung</a>.
			</p>
			<div class="mt-4 flex gap-2">
				<button
					id="cookie-decline"
					type="button"
					class="flex-1 rounded-full border border-line px-4 py-2.5 text-sm font-medium text-ink-2 hover:bg-mist"
				>
					Ablehnen
				</button>
				<button
					id="cookie-accept"
					type="button"
					class="flex-1 rounded-full bg-ink px-4 py-2.5 text-sm font-medium text-white hover:bg-brand-ink"
				>
					Akzeptieren
				</button>
			</div>
		</div>

		<script>
			const PARAMS_KEY = 'dw_params';
			const w = window as any;

			function storedParams(): URLSearchParams {
				const merged = new URLSearchParams();
				try {
					const saved = sessionStorage.getItem(PARAMS_KEY);
					if (saved) new URLSearchParams(saved).forEach((v, k) => merged.set(k, v));
				} catch {}
				new URLSearchParams(window.location.search).forEach((v, k) => merged.set(k, v));
				try {
					if ([...merged.keys()].length) sessionStorage.setItem(PARAMS_KEY, merged.toString());
				} catch {}
				return merged;
			}

			function decorateOutboundLinks(params: URLSearchParams) {
				document.querySelectorAll<HTMLAnchorElement>('a[href*="improic.com"]').forEach((anchor) => {
					const url = new URL(anchor.href);
					params.forEach((value, key) => url.searchParams.set(key, value));
					if (!url.searchParams.has('utm_source')) {
						url.searchParams.set('utm_source', 'dental-wissen');
						url.searchParams.set('utm_medium', 'referral');
						url.searchParams.set('utm_content', anchor.dataset.cta || 'link');
					}
					anchor.href = url.toString();
				});
			}

			function trackCtaClicks() {
				document.addEventListener('click', (event) => {
					const anchor = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-cta]');
					if (!anchor) return;
					w.dataLayer = w.dataLayer || [];
					w.dataLayer.push({
						event: 'cta_click',
						cta_id: anchor.dataset.cta,
						cta_destination: anchor.hostname.includes('improic.com') ? 'shop' : 'internal',
						link_url: anchor.href,
					});
				});
			}

			decorateOutboundLinks(storedParams());
			trackCtaClicks();
		</script>

		<script>
			const CONSENT_KEY = 'dw_consent';
			const w = window as any;

			function gtag(..._args: unknown[]) {
				w.dataLayer = w.dataLayer || [];
				w.dataLayer.push(arguments);
			}

			function applyConsent(granted: boolean) {
				const state = granted ? 'granted' : 'denied';
				gtag('consent', 'update', {
					ad_storage: state,
					ad_user_data: state,
					ad_personalization: state,
					analytics_storage: state,
				});
			}

			const banner = document.getElementById('cookie-banner');

			function choose(granted: boolean) {
				try {
					localStorage.setItem(CONSENT_KEY, granted ? 'granted' : 'denied');
				} catch {}
				applyConsent(granted);
				banner?.classList.add('hidden');
			}

			let stored: string | null = null;
			try {
				stored = localStorage.getItem(CONSENT_KEY);
			} catch {}
			if (stored !== 'granted' && stored !== 'denied') banner?.classList.remove('hidden');

			document.getElementById('cookie-accept')?.addEventListener('click', () => choose(true));
			document.getElementById('cookie-decline')?.addEventListener('click', () => choose(false));
			document.querySelectorAll('[data-open-consent]').forEach((el) =>
				el.addEventListener('click', () => banner?.classList.remove('hidden')),
			);
		</script>
	</body>
</html>
