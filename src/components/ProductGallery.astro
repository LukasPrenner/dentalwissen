---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	images: { src: ImageMetadata; alt: string }[];
}

const { images } = Astro.props;
---

<div class="product-gallery" data-gallery>
	<div class="relative overflow-hidden rounded-3xl border border-line bg-white">
		<div
			class="flex snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
			data-track
			tabindex="0"
			aria-roledescription="Bildergalerie"
		>
			{
				images.map((image, i) => (
					<div class="aspect-square w-full shrink-0 snap-center" data-slide aria-label={`Bild ${i + 1} von ${images.length}`}>
						<Image
							src={image.src}
							alt={image.alt}
							widths={[480, 720, 1000, 1400]}
							sizes="(min-width: 1024px) 560px, 100vw"
							loading={i === 0 ? 'eager' : 'lazy'}
							fetchpriority={i === 0 ? 'high' : 'auto'}
							class="size-full object-cover"
						/>
					</div>
				))
			}
		</div>

		<button
			type="button"
			data-prev
			aria-label="Vorheriges Bild"
			class="absolute top-1/2 left-3 grid size-10 -translate-y-1/2 place-items-center rounded-full border border-line bg-white/90 text-ink shadow-sm backdrop-blur transition hover:bg-white disabled:opacity-0"
		>
			<svg viewBox="0 0 20 20" fill="none" class="size-5" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		</button>
		<button
			type="button"
			data-next
			aria-label="Nächstes Bild"
			class="absolute top-1/2 right-3 grid size-10 -translate-y-1/2 place-items-center rounded-full border border-line bg-white/90 text-ink shadow-sm backdrop-blur transition hover:bg-white disabled:opacity-0"
		>
			<svg viewBox="0 0 20 20" fill="none" class="size-5" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		</button>

		<p class="absolute right-3 bottom-3 rounded-full bg-ink/75 px-2.5 py-1 text-xs font-medium text-white tabular-nums" data-counter>
			1 / {images.length}
		</p>
	</div>

	<div class="mt-3 grid grid-cols-4 gap-3 sm:grid-cols-5">
		{
			images.map((image, i) => (
				<button
					type="button"
					data-thumb={i}
					aria-label={`Bild ${i + 1} anzeigen`}
					class="overflow-hidden rounded-xl border-2 border-transparent bg-white ring-1 ring-line transition data-[active=true]:border-brand data-[active=true]:ring-0"
					data-active={i === 0 ? 'true' : 'false'}
				>
					<Image src={image.src} alt="" widths={[160]} sizes="120px" class="aspect-square w-full object-cover" />
				</button>
			))
		}
	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
		const track = gallery.querySelector<HTMLElement>('[data-track]')!;
		const slides = [...gallery.querySelectorAll<HTMLElement>('[data-slide]')];
		const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
		const prev = gallery.querySelector<HTMLButtonElement>('[data-prev]')!;
		const next = gallery.querySelector<HTMLButtonElement>('[data-next]')!;
		const counter = gallery.querySelector<HTMLElement>('[data-counter]')!;
		let current = 0;

		const goTo = (index: number) => {
			const target = Math.max(0, Math.min(slides.length - 1, index));
			track.scrollTo({ left: target * track.clientWidth, behavior: 'smooth' });
		};

		const render = () => {
			prev.disabled = current === 0;
			next.disabled = current === slides.length - 1;
			counter.textContent = `${current + 1} / ${slides.length}`;
			thumbs.forEach((thumb, i) => (thumb.dataset.active = String(i === current)));
		};

		track.addEventListener(
			'scroll',
			() => {
				const index = Math.round(track.scrollLeft / track.clientWidth);
				if (index !== current) {
					current = index;
					render();
				}
			},
			{ passive: true },
		);

		prev.addEventListener('click', () => goTo(current - 1));
		next.addEventListener('click', () => goTo(current + 1));
		thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => goTo(i)));
		track.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') goTo(current - 1);
			if (event.key === 'ArrowRight') goTo(current + 1);
		});

		render();
	});
</script>
