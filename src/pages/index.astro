---
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = [
	{
		slug: 'zahnpasta-inhaltsstoffe',
		title: 'Welche Inhaltsstoffe in Zahnpasta wirklich zählen',
		excerpt: 'Ein Überblick über Fluorid, Hydroxylapatit und Co. – wissenschaftlich eingeordnet.',
		readTime: '6 Min. Lesezeit',
	},
];
---

<BaseLayout title="Dental Wissen – Zahngesundheit verständlich erklärt">
	<section class="mx-auto max-w-3xl px-4 py-12">
		<h1 class="text-3xl font-bold tracking-tight">Zahngesundheit, verständlich erklärt</h1>
		<p class="mt-3 text-slate-600">Unabhängige Ratgeber und Einordnungen zu Zahnpflege, Produkten und Behandlungen.</p>

		<div class="mt-10 grid gap-6">
			{
				articles.map((article) => (
					<a href={`/artikel/${article.slug}`} class="block rounded-lg border border-slate-200 p-5 transition hover:border-slate-300 hover:shadow-sm">
						<h2 class="text-xl font-semibold">{article.title}</h2>
						<p class="mt-2 text-slate-600">{article.excerpt}</p>
						<p class="mt-3 text-sm text-slate-400">{article.readTime}</p>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>
