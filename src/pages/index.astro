---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import tubeKarton from '../assets/produkt/01-tube-karton.jpg';
---

<BaseLayout title="Dental Wissen – Zahnpflege verständlich erklärt">
	<section class="border-b border-line bg-gradient-to-b from-mist to-white">
		<div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
			<p class="text-sm font-medium text-brand-deep">Dental Wissen</p>
			<h1 class="mt-3 max-w-3xl font-serif text-4xl leading-[1.1] font-semibold tracking-tight text-ink sm:text-6xl">
				Zahnpflege, verständlich erklärt.
			</h1>
			<p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-2 sm:text-xl">
				Was im Mund zwischen zwei Mal Putzen passiert, worauf es bei der Pflege ankommt – und welche Zahnpasta wir
				empfehlen.
			</p>
		</div>
	</section>

	<section class="mx-auto mt-12 grid max-w-6xl gap-5 px-4 sm:px-6 md:grid-cols-2">
		<a
			href="/zahnpflege-zahnpasta"
			data-cta="home-ratgeber"
			class="group flex flex-col justify-between rounded-3xl bg-teal-soft p-7 transition hover:shadow-[0_16px_40px_-20px_rgba(20,33,43,0.3)] sm:p-10"
		>
			<div>
				<p class="text-sm font-medium text-brand-ink/70">Ratgeber · 8 Min. Lesezeit</p>
				<h2 class="mt-3 font-serif text-3xl leading-tight font-semibold tracking-tight text-ink">
					Was zwischen zwei Mal Zähneputzen in Ihrem Mund passiert
				</h2>
				<p class="mt-3 leading-relaxed text-ink-2">
					Belag, Biofilm und Zahnfleisch: was die Forschung weiß und wie eine durchdachte tägliche Pflege aussieht.
				</p>
			</div>
			<p class="mt-8 inline-flex items-center gap-2 font-semibold text-ink">
				Artikel lesen
				<span class="transition group-hover:translate-x-1" aria-hidden="true">→</span>
			</p>
		</a>

		<a
			href="/improic-zahnpasta"
			data-cta="home-produkt"
			class="group grid grid-cols-[1fr_auto] items-end gap-4 rounded-3xl border border-line bg-white p-7 transition hover:shadow-[0_16px_40px_-20px_rgba(20,33,43,0.3)] sm:p-10"
		>
			<div class="flex h-full flex-col justify-between">
				<div>
					<p class="text-sm font-medium text-muted">Unsere Empfehlung</p>
					<h2 class="mt-3 font-serif text-3xl leading-tight font-semibold tracking-tight text-ink">IMPROIC® Zahnpasta</h2>
					<p class="mt-3 leading-relaxed text-ink-2">Mit Mikrosilber, Fluorid und pflanzlichen Inhaltsstoffen.</p>
				</div>
				<p class="mt-8 inline-flex items-center gap-2 font-semibold text-ink">
					Zur Zahnpasta
					<span class="transition group-hover:translate-x-1" aria-hidden="true">→</span>
				</p>
			</div>
			<Image src={tubeKarton} alt="IMPROIC® Zahnpasta" widths={[240, 400]} sizes="180px" class="w-32 sm:w-44" />
		</a>
	</section>
</BaseLayout>
